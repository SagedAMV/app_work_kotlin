<?xml version="1.0" encoding="utf-8"?>
<!--
  تطبيق «مجرة» — نظام إدارة مواقع الاتصالات
  قاعدة صارمة: التطبيق أوفلاين 100٪، لذلك لا يوجد إذن INTERNET إطلاقًا،
  وأي مكتبة تتطلب اتصالًا ممنوعة حسب ملف التعليمات.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- إذن البصمة + الموقع المحلي (GPS أوفلاين) — بدون أي أذون شبكة -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".GalaxyApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Majarra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          تعطيل التهيئة التلقائية لـ WorkManager عبر androidx.startup
          لأننا نستخدم HiltWorkerFactory (تهيئة عند الطلب).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>
</manifest>
